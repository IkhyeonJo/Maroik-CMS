<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <PropertyGroup>
    <NoWarn>1591</NoWarn>
    <!-- Compiler warnings fail the build so they cannot accumulate unnoticed.
         The solution currently builds warning-clean; keep it that way. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- .editorconfig code-style violations (IDExxxx) are enforced at build time too. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Needed for IDE0005 (unnecessary using) to run at build time, and checks the XML doc comments' references
         (paramref / cref / param names). Missing doc comments themselves (CS1591) stay allowed by the NoWarn above. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <PropertyGroup>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <!--
    Banned APIs (BannedSymbols.txt) for every production project, Domain and Contract included: a build-time analyzer
    only (PrivateAssets=all, nothing ships with the assembly), so it is declared here rather than in each .csproj, whose
    PackageReference graph SolutionLayeringArchitectureTests checks for runtime dependencies. Test projects and
    docker-compose.dcproj (no target framework) are left out.
  -->
  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.csproj' And !$(MSBuildProjectName.EndsWith('.Tests'))">
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
  </ItemGroup>
  <!--
    One type per file, named after it (StyleCop SA1402 / SA1649), for every project, test projects included. A
    build-time analyzer only, like BannedApiAnalyzers above. stylecop.globalconfig turns every other StyleCop rule off;
    stylecop.json makes SA1402 count every kind of top-level type, not only classes.
  -->
  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <PackageReference Include="StyleCop.Analyzers" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)stylecop.json" />
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)stylecop.globalconfig" />
  </ItemGroup>
  <!--
    Plural folder names: the folder that directly holds a .cs file is named with a plural noun (Accounts, Fixtures,
    ArchitectureRules, Mappers), never a singular noun, an adjective or a mass/concept word (Account, Shared,
    Infrastructure, Misc). A concept word is replaced by a noun that has a plural, then pluralized (Time -> TimeZones,
    Media -> Uploads). The check is "ends in s", so an irregular plural would need its own entry here.
    .editorconfig cannot see folder names, so this is an MSBuild warning (MAROIK0001); TreatWarningsAsErrors covers
    compiler warnings only, so it stays a warning, and the zero-warning build rule keeps it from accumulating.
    Maroik.Core.PostgreSQL is held to it too: its scaffold puts the context in Contexts and the entities in Models.
  -->
  <Target Name="CheckPluralFolderNames" BeforeTargets="CoreCompile" Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <PropertyGroup>
      <_PluralCheckProjectDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)'))</_PluralCheckProjectDir>
      <_PluralCheckObjDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)'))</_PluralCheckObjDir>
      <_PluralCheckBinDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(BaseOutputPath)'))</_PluralCheckBinDir>
    </PropertyGroup>
    <ItemGroup>
      <_PluralCheckFolder Include="@(Compile->'%(RootDir)%(Directory)')"
                          Condition="$([System.String]::Copy('%(Compile.FullPath)').StartsWith('$(_PluralCheckProjectDir)'))
                                     And !$([System.String]::Copy('%(Compile.FullPath)').StartsWith('$(_PluralCheckObjDir)'))
                                     And !$([System.String]::Copy('%(Compile.FullPath)').StartsWith('$(_PluralCheckBinDir)'))" />
      <_PluralCheckFolder Remove="$(_PluralCheckProjectDir)" />
    </ItemGroup>
    <ItemGroup>
      <_PluralCheckFolder>
        <Leaf>$([System.IO.Path]::GetFileName($([System.String]::Copy('%(Identity)').TrimEnd('/').TrimEnd('\'))))</Leaf>
      </_PluralCheckFolder>
    </ItemGroup>
    <Warning Code="MAROIK0001"
             Condition="!$([System.String]::Copy('%(_PluralCheckFolder.Leaf)').EndsWith('s', System.StringComparison.Ordinal))"
             File="%(_PluralCheckFolder.Identity)"
             Text="Folder '%(_PluralCheckFolder.Leaf)' holds .cs files but is not a plural noun. Rename it to a plural (Account -&gt; Accounts); replace an adjective or concept word with a noun that has a plural (Shared -&gt; Layouts, Time -&gt; TimeZones), and rename its namespace to match." />
  </Target>
</Project>
