# ─────────────────────────────────────────────────────────────────────────────
# Maroik — LOCAL / DEBUG environment for docker-compose.debug.yml.
#
# Every value here is a throwaway, local-development-only default so that
#   docker compose -f docker-compose.debug.yml up -d --build
# works out of the box. None of these credentials protect anything real: the
# services are reachable only on the private "backend" Docker network, and the
# RSA key pair below was generated for this public repository.
# Never reuse these values for a deployment — generate your own.
# ─────────────────────────────────────────────────────────────────────────────

# ── ASP.NET Core ────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=DockerComposeLocalDebug
ASPNETCORE_URLS=https://+:443;http://+:80

# ── PostgreSQL (postgres image) ─────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=maroik-local-dev
POSTGRES_DB=Maroik

# ── RabbitMQ (rabbitmq image) ───────────────────────────────────────────────
RABBITMQ_DEFAULT_USER=maroik
RABBITMQ_DEFAULT_PASS=maroik-local-dev

# ── Connection strings (service DNS names on the "backend" network) ─────────
ConnectionStrings__DefaultConnection=Host=Maroik.PostgreSQL;Port=5432;Database=Maroik;Username=postgres;Password=maroik-local-dev
ConnectionStrings__Valkey=Maroik.Valkey:6379,abortConnect=false
ConnectionStrings__RabbitMQ=amqp://maroik:maroik-local-dev@Maroik.RabbitMQ:5672/

# ── Internal services ───────────────────────────────────────────────────────
FileStorage__BaseUrl=http://Maroik.FileStorage
Clamav__Host=Maroik.Clamav
Clamav__Port=3310

# ── Application settings ────────────────────────────────────────────────────
ServerSetting__DomainName=https://localhost/
ServerSetting__MaxLoginAttempt=3
ServerSetting__SessionExpireMinutes=10
ServerSetting__NoticeMaturityDateDay=3
ServerSetting__MaxAttachedFileSizeBytes=10485760

# The demo account (seeded by Maroik.DB/.../Debugging/Init.sql) always sees this month on its dashboard.
ServerSetting__DemoAccountEmail=demo@maroik.com
ServerSetting__DemoDashboardYear=2025
ServerSetting__DemoDashboardMonth=06

# Kestrel's TLS certificate comes from ASPNETCORE_Kestrel__Certificates__Default__* in
# docker-compose.debug.yml. Set these two only to enable the hot-reloading certificate
# (e.g. a Let's Encrypt cert renewed on disk).

# ── SMTP → Mailpit (local mail catcher, inbox at http://localhost:8025) ─────
# Mailpit accepts any credentials, so no real mail account is needed.
ServerSetting__SmtpOptions__smtpUserName=maroik
ServerSetting__SmtpOptions__smtpPassword=maroik-local-dev
ServerSetting__SmtpOptions__smtpHost=Maroik.Mailpit
ServerSetting__SmtpOptions__smtpPort=1025
ServerSetting__SmtpOptions__smtpSsl=false
ServerSetting__SmtpOptions__fromEmail=noreply@example.com
ServerSetting__SmtpOptions__fromFullName=Maroik
ServerSetting__SmtpOptions__IsDefault=true

# ── RSA key pair (login form password encryption) ───────────────────────────
# Base64 DER: private = PKCS#1 RSAPrivateKey, public = X.509 SubjectPublicKeyInfo.
# Regenerate with:
#   openssl genrsa -traditional -out rsa.pem 2048
#   openssl rsa -in rsa.pem -outform DER -traditional | base64 -w0   # -> RsaPrivateKey
#   openssl rsa -in rsa.pem -pubout -outform DER | base64 -w0        # -> RsaPublicKey
ServerSetting__RsaAlgorithm=Rsa2
ServerSetting__
ServerSetting__
