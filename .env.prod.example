# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=maroik-local-dev
POSTGRES_DB=Maroik

# Database Connection String
ConnectionStrings__DefaultConnection=Host=postgresql;Port=5432;Database=Maroik;Username=postgres;Password=maroik-local-dev
ConnectionStrings__Valkey=Maroik.Valkey:6379,abortConnect=false

# RabbitMQ Configuration
RABBITMQ_DEFAULT_USER=maroik
RABBITMQ_DEFAULT_PASS=maroik-local-dev
ConnectionStrings__RabbitMQ=amqp://maroik:maroik-local-dev@Maroik.RabbitMQ:5672/

# ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Production

# .NET Generic Host Environment (used by Maroik.Worker, which is not an ASP.NET Core app)
DOTNET_ENVIRONMENT=Production

# ASP.NET Core URLs
ASPNETCORE_URLS=http://+:80

# Server Settings
ServerSetting__DomainName=https://www.maroik.com/
ServerSetting__MaxLoginAttempt=3
ServerSetting__SessionExpireMinutes=10
ServerSetting__NoticeMaturityDateDay=3
ServerSetting__MaxAttachedFileSizeBytes=10485760
ServerSetting__DemoAccountEmail=demo@maroik.com
ServerSetting__DemoDashboardYear=2025
ServerSetting__DemoDashboardMonth=06

# SMTP Configuration
ServerSetting__SmtpOptions__smtpUserName=maroik
ServerSetting__SmtpOptions__smtpPassword=maroik-local-dev
ServerSetting__SmtpOptions__smtpHost=smtp-relay.brevo.com
ServerSetting__SmtpOptions__smtpPort=587
ServerSetting__SmtpOptions__smtpSsl=true
ServerSetting__SmtpOptions__fromEmail=noreply@maroik.com
ServerSetting__SmtpOptions__fromFullName=Maroik
ServerSetting__SmtpOptions__IsDefault=true

# FileStorage Configuration
FileStorage__BaseUrl=http://Maroik.FileStorage

# ClamAV Configuration
Clamav__Host=Maroik.Clamav
Clamav__Port=3310

# Crontab Script Configuration
MAROIK_BASE_DIR=/home/ubuntu/Maroik
MAROIK_LOG_DIR=/home/ubuntu/Maroik/Maroik.Log

# External Drive Configuration for Backup
# Get UUID with: sudo blkid
# Example: 1234-5678-90AB-CDEF
EXTERNAL_DRIVE_UUID=
EXTERNAL_DRIVE_MOUNT=/home/ubuntu/512GB
BACKUP_BASE_DIR=/home/ubuntu/512GB/Maroik-Backup

# Cloudflare Tunnel (cloudflared): the connector token from Zero Trust > Networks > Tunnels
TUNNEL_TOKEN=
