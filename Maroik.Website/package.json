{
  "name": "maroik-website-clientscripts",
  "version": "1.0.0",
  "private": true,
  "description": "TypeScript sources for Maroik.Website custom client scripts. tsc compiles TypeScripts/**/*.ts -> wwwroot/**/*.js 1:1. No bundler: each site.ts is a self-contained IIFE global script with no imports. See TypeScripts/README.md.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:debug": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "check": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "devDependencies": {
    "@fullcalendar/core": "5.5.1",
    "@types/chart.js": "2.9.41",
    "@types/jquery": "3.5.34",
    "@types/jquery.validation": "1.17.1",
    "@types/jqueryui": "1.12.24",
    "@types/jsdom": "27.0.0",
    "@types/summernote": "0.8.10",
    "@types/toastr": "2.1.44",
    "jquery": "3.6.0",
    "jsdom": "30.0.1",
    "moment": "2.30.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
