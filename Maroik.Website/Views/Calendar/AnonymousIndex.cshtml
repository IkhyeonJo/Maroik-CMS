            </div>
        </div>
    </div>
</div>

@* Page-specific CSS: site.css *@
@section Styles {
    <link rel="stylesheet" href="~/anonymous/custom/Calendar/AnonymousIndex/css/site.css" asp-append-version="true">
}

@* Page-specific JavaScript: site.js *@
@section Scripts {
