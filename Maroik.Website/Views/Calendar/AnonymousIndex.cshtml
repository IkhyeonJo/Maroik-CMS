@*
    Calendar/AnonymousIndex.cshtml
    Public read-only calendar view for anonymous users.
    Uses the CalendarOutputViewModel to render all shared (Anonymous-type) calendars and their events
    in a FullCalendar.js grid. Events are serialised to JSON for the FullCalendar initialisation script.
    The time grid is scrolled to the user's current local time on page load.
    No create/edit/delete controls are shown; the calendar is read-only.
*@
@using Maroik.Website.Models.ViewModels.Calendar
@using Maroik.Core.Domain.Calendar
@model CalendarOutputViewModel

@{
    var timeIntervals = Model.TimeIntervals;
}

@* Reminder lead-time bounds + the "notify at HH:MM" list — authoritative in CalendarReminderPolicy
   / the view model. This page only displays reminders (disabled inputs), but it reads the same
   values so it never drifts from the create/edit pages. *@
@Html.Hidden("maxMinutesBeforeEvent", CalendarReminderPolicy.MaxMinutesBeforeEvent)
@Html.Hidden("maxHoursBeforeEvent", CalendarReminderPolicy.MaxHoursBeforeEvent)
@Html.Hidden("maxDaysBeforeEvent", CalendarReminderPolicy.MaxDaysBeforeEvent)
@Html.Hidden("maxWeeksBeforeEvent", CalendarReminderPolicy.MaxWeeksBeforeEvent)
@Html.Hidden("reminderTimeIntervals", JsonSerialization.ToClientJson(Model.TimeIntervals))
@Html.Hidden("defaultReminderTimeOfDay", CalendarReminderPolicy.DefaultReminderTimeOfDay)

