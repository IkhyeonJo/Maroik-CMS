@*
    Calendar/AdminIndex.cshtml
    Admin calendar view with full CRUD capabilities.
    Uses CalendarOutputViewModel to render the admin's own calendars and events plus
    any subscribed (other) calendars in a FullCalendar.js grid.
    Includes create/edit/delete modals for calendars, events, reminders, file attachments,
    and calendar-sharing settings. Events are serialised to JSON for FullCalendar initialisation.
    The time grid is scrolled to the admin's current local time on page load.
*@
@using Maroik.Website.Models.ViewModels.Calendar
@using Maroik.Core.Domain.Calendar
@model CalendarOutputViewModel

@{
    var loggedInAccount = Model.LoggedInAccount;
    string currentDate = Model.CurrentDate;
    var timeIntervals = Model.TimeIntervals;
    string currentInterval = Model.CurrentInterval;
    long maxAttachedFileSizeBytes = (long)ViewBag.MaxAttachedFileSizeBytes;
}
@Html.Hidden(nameof(maxAttachedFileSizeBytes), maxAttachedFileSizeBytes)
@Html.Hidden("loggedInAccountTimeZoneIanaId", loggedInAccount.TimeZoneIanaId)
@* Reminder lead-time bounds — authoritative in CalendarReminderPolicy; the client check reads these instead of hardcoding. *@
@Html.Hidden("maxMinutesBeforeEvent", CalendarReminderPolicy.MaxMinutesBeforeEvent)
@Html.Hidden("maxHoursBeforeEvent", CalendarReminderPolicy.MaxHoursBeforeEvent)
@Html.Hidden("maxDaysBeforeEvent", CalendarReminderPolicy.MaxDaysBeforeEvent)
@Html.Hidden("maxWeeksBeforeEvent", CalendarReminderPolicy.MaxWeeksBeforeEvent)
@* "Notify at HH:MM" options + default, from CalendarReminderPolicy / the view model, so the client stops regenerating the 15-minute list. *@
@Html.Hidden("reminderTimeIntervals", JsonSerialization.ToClientJson(Model.TimeIntervals))
@Html.Hidden("defaultReminderTimeOfDay", CalendarReminderPolicy.DefaultReminderTimeOfDay)
@Html.Hidden("localizerEmail", Localizer["Email"].Value)
@Html.Hidden("localizerNotification", Localizer["Notification"].Value)
