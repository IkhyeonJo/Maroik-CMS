@*
    Shared/_MainTopBar.cshtml
    AdminLTE top navigation bar partial, rendered once per page via _Layout.
    Model: AccountResponse of the logged-in user (or an anonymous placeholder).
    Behaviour varies by role:
      - Admin   : Language switcher + user avatar dropdown (Profile / Sign out).
      - User    : Notification bell (fixed income/expenditure alerts) + language switcher + avatar dropdown.
      - Anonymous: Language switcher + Login button.
    Notification badge count is the sum of Noticed and Expired fixed-income/expenditure records
    passed from the controller via ViewBag.
*@
@model Maroik.Core.Contract.Dtos.AccountResponse
@{
    string currentCulture = ViewBag.CurrentCulture as string ?? "en-US";
    int fixedIncomesTotalNoticeCount = ViewBag.FixedIncomesTotalNoticeCount as int? ?? 0;
    int fixedExpenditureTotalNoticeCount = ViewBag.FixedExpenditureTotalNoticeCount as int? ?? 0;
    int totalNoticeCount = ViewBag.TotalNoticeCount as int? ?? 0;
}

