@*
    Exception/AccessDenied.cshtml
    Shown when a user attempts to access a resource they are not authorised to view.
    Rendered through the minimal _ExceptionLayout so it displays correctly regardless of session state.
*@
@{
    ViewData["Title"] = "AccessDenied";
}

<h1 class="text-danger">AccessDenied.</h1>
<h2 class="text-danger">An error occurred while processing your request.</h2>

<h3>Access Denied</h3>