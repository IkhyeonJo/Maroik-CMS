@*
    Management/Profile.cshtml
    Admin self-service profile edit page.
    Displays the admin's current profile details (email, avatar, nickname, member-since date).
    Contains separate form sections for:
      - Updating nickname and avatar image.
      - Changing password (current + new + confirm new).
      - Changing the preferred time-zone.
    The logged-in account is read from Context.GetLoggedInAccount() to pre-populate read-only fields.
*@
@model Maroik.Website.Models.ViewModels.Managements.ProfileOutputViewModel
@using Maroik.Core.Domain.Uploads

@{
    AccountResponse loggedInAccount = Context.GetLoggedInAccount();
    long maxAttachedFileSizeBytes = (long)ViewBag.MaxAttachedFileSizeBytes;
}
@Html.Hidden(nameof(maxAttachedFileSizeBytes), maxAttachedFileSizeBytes)
@* Accepted avatar image types — authoritative in ImageUploadPolicy (also enforced server-side). *@
@Html.Hidden("allowedImageContentTypes", ClientJsonSerializer.Serialize(ImageUploadPolicy.AllowedContentTypes))
<section class="content">
    <div class="container-fluid">
        @if (Model.MustChangePassword)
        {
            <div class="row">
                <div class="col-md-12">
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle"></i>
                        @Localizer["Your password was reset by an administrator. Please set a new password below before continuing."]
                    </div>
                </div>
            </div>
        }
        <div class="row">
            <div class="col-md-3">
                @*<!-- Profile Image -->*@
                <div class="card card-primary card-outline">
                    <div class="card-body box-profile">
                        <div class="text-center">
                            <img class="profile-user-img img-fluid img-circle"
                                 src="@Model.AvatarImagePath"
                                 alt="@Localizer["User profile picture"]">
                        </div>
                        <h3 class="profile-username text-center">@Model.Nickname</h3>
                        <ul class="list-group list-group-unbordered mb-3">
                            <li class="list-group-item">
                                <b>@Localizer["Create"]</b> <span class="float-right">@Model.Created.ConvertTimeByTimeZoneIanaId(Model.TimeZoneIanaId ?? "").ToString("d")</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="col-md-9">
                <div class="card">
                    <div class="card-header p-2">
                        <ul class="nav nav-pills">
                            <li class="nav-item"><a class="nav-link active" href="#settings" data-toggle="tab">@Localizer["Settings"]</a></li>
                        </ul>
                    </div>
                    <div class="card-body">
                        <div class="tab-content">



                            <div class="active tab-pane" id="settings">
                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="card card-primary card-outline">
                                            <div class="card-header">
                                                <h3 class="card-title">
                                                    <i class="fas fa-user-circle fa-lg"></i>
                                                    @Localizer["Avatar Image"]
                                                </h3>
                                            </div>
                                            <div class="card-body pad table-responsive">

                                                <div class="row">
                                                    <div class="col-lg-4">
                                                        <div class="row" style="padding-bottom: 10px;">
                                                            <div class="col-lg-12">
                                                                <img class="profile-user-img img-responsive img-circle" src="@Model.AvatarImagePath" alt="@Localizer["Profile picture"]">
                                                            </div>
                                                        </div>

                                                        <div class="row">
                                                            <div class="col-lg-12">
                                                                <div class="cols-sample-area">
                                                                    <div class="frame">
                                                                        <div class="control">
                                                                            <form id="formUpdateProfileAvatar" method="POST" enctype="multipart/form-data">
                                                                                <div class="form-group">
                                                                                    <div class="btn btn-default btn-file">
                                                                                        <i class="fas fa-paperclip" style="padding-right: 3px;"></i>&nbsp;&nbsp;&nbsp;@Localizer["Browse"]
                                                                                        <input type="file" name="ProfileAvatarFiles" id="ProfileAvatarFiles" data-noFileAttachedErrorMessage="@Localizer["Please attach a file."]" data-fileSizeLimitationErrorMessage="@Localizer["File Size must be smaller than {0}MB.", maxAttachedFileSizeBytes.ToMegabytesLabel()]" data-fileTypeErrorMessage="@Localizer["Only .jpg or jpeg or .png file allowed."]" accept="@(string.Join(", ", ImageUploadPolicy.AllowedContentTypes))">
                                                                                    </div>
                                                                                </div>
                                                                            </form>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <div class="col-lg-8">
                                                        <div class="form-group">
                                                            <div class="col-lg-3">@Localizer["Email"]</div>
                                                            <div class="col-lg-9"><input class="form-control" value="@Model.Email" disabled /></div>
                                                        </div>
                                                        <div class="form-group">
                                                            <div class="col-lg-3">@Localizer["Nickname"]</div>
                                                            <div class="col-lg-9"><input class="form-control" value="@Model.Nickname" disabled /></div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="card card-primary card-outline">
                                            <div class="card-header">
                                                <h3 class="card-title">
                                                    <i class="fas fa-key"></i>
                                                    @Localizer["Change Password"]
                                                </h3>
                                            </div>
                                            <div class="card-body pad table-responsive">
                                                <form id="formUpdateProfilePassword" class="form-horizontal" method="post">
                                                    <div class="form-group row">
                                                        <label asp-for="Password" class="col-sm-2 col-form-label">@Localizer["Password"]</label>
                                                        <div class="col-sm-10">
                                                            <input asp-for="Password" type="password" class="form-control" placeholder="@Localizer["Password"]" />
                                                            <span asp-validation-for="Password" class="text-danger"></span>
                                                        </div>
                                                    </div>
                                                    <div class="form-group row">
                                                        <label asp-for="NewPassword" class="col-sm-2 col-form-label">@Localizer["New Password"]</label>
                                                        <div class="col-sm-10">
                                                            <input asp-for="NewPassword" type="password" class="form-control" placeholder="@Localizer["New Password"]" />
                                                            <span asp-validation-for="NewPassword" class="text-danger"></span>
                                                        </div>
                                                    </div>
                                                    <div class="form-group row">
                                                        <label asp-for="ConfirmNewPassword" class="col-sm-2 col-form-label">@Localizer["Confirm new password"]</label>
                                                        <div class="col-sm-10">
                                                            <input asp-for="ConfirmNewPassword" type="password" class="form-control" placeholder="@Localizer["Confirm new password"]" />
                                                            <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
                                                        </div>
                                                    </div>
                                                    <div class="form-group row">
                                                        <div class="offset-sm-2 col-sm-10">
                                                            <button type="submit" class="btn btn-danger">@Localizer["Modify"]</button>
                                                        </div>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="card card-primary card-outline">
                                            <div class="card-header">
                                                <h3 class="card-title">
                                                    <i class="fas fa-clock"></i>
                                                    @Localizer["Time zone"] 
                                                </h3>
                                            </div>
                                            <div class="card-body pad table-responsive">
                                                <form id="formUpdateProfileTimeZone" class="form-horizontal" method="post" asp-controller="Management" asp-action="UpdateProfileTimeZone">
                                                    <div class="form-group row">
                                                        <label asp-for="TimeZoneIanaId" class="col-sm-2 col-form-label">@Localizer["Time zone"]</label>
                                                        <div class="col-sm-10">
                                                            <select asp-for="TimeZoneIanaId" class="form-control" style="max-width:100%;text-overflow:ellipsis;">
                                                                @foreach (var timeZoneOption in (IEnumerable<TimeZoneOptionDto>)ViewBag.TimeZoneOptions)
                                                                {
                                                                    <option value="@timeZoneOption.IanaId">@timeZoneOption.DisplayName</option>
                                                                }
                                                            </select>
                                                            <span id="timeZoneError" class="text-danger">@(TempData[Maroik.Website.Constants.TempDataKeys.TimeZoneError] as string)</span>
                                                        </div>
                                                    </div>
                                                    <div class="form-group row">
                                                        <div class="offset-sm-2 col-sm-10">
                                                            <button type="submit" class="btn btn-danger">@Localizer["Modify"]</button>
                                                        </div>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@* Page-specific JavaScript: site.js, site.js *@
@section Scripts{
    @switch (loggedInAccount.Role)
    {
        case Role.Admin:
            <script src="~/admin/custom/Management/Profile/js/site.js" asp-append-version="true"></script>
            break;
        case Role.User:
            <script src="~/user/custom/Management/Profile/js/site.js" asp-append-version="true"></script>
            break;
    }
}
