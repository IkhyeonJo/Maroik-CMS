@*
    Account/_Layout.cshtml
    Standalone layout used exclusively by Account views (Login, Register, ForgotPassword, ResetPassword, ConfirmEmail).
    Does not extend the main AdminLTE shell — sets Layout = null and renders a full self-contained HTML page
    with a full-screen background image and minimal static assets (Font Awesome, iCheck Bootstrap, AdminLTE).
    Embeds the anti-forgery token and the return-URI hidden field for post-login redirect.
*@
@{
    Layout = null;
    string returnUri = ViewBag.ReturnUri as string ?? "/";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Maroik</title>

    @*HomePage Site Icon*@
    <link rel="Shortcut Icon" href="~/anonymous/favicon.ico" type="image/x-icon" />
    @*<!-- Font Awesome -->*@
    <link rel="stylesheet" href="~/anonymous/plugins/fontawesome-free/css/all.min.css" asp-append-version="true">
    @*<!-- icheck bootstrap -->*@
    <link rel="stylesheet" href="~/anonymous/plugins/icheck-bootstrap/icheck-bootstrap.min.css" asp-append-version="true">
    @*<!-- Theme style -->*@
    <link rel="stylesheet" href="~/anonymous/dist/css/adminlte.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/anonymous/custom/_AdminlteBlank/css/site.css" asp-append-version="true">
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="hold-transition login-page" style="background-image: url('@Url.Content("~/anonymous/images/bg1.jpg")'); background-size: cover;">
    @*Validation of form*@
    @Html.AntiForgeryToken()
    @*Language change return URI*@
    @Html.Hidden($"{nameof(returnUri)}",returnUri)

    @RenderBody()
    @*<!-- jQuery -->*@
    <script src="~/anonymous/plugins/jquery/jquery.min.js" asp-append-version="true"></script>
    <script src="~/anonymous/lib/jquery-validation/dist/jquery.validate.min.js" asp-append-version="true"></script>
    <script src="~/anonymous/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js" asp-append-version="true"></script>
    @*<!-- Bootstrap 4 -->*@
    <script src="~/anonymous/plugins/bootstrap/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    @*<!-- AdminLTE App -->*@
    <script src="~/anonymous/dist/js/adminlte.min.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>