@*
    AccountBook/Asset.cshtml
    Personal asset management page (account book).
    Displays a NonFactors MVC Grid listing all the user's financial assets (partial view _AssetGrid).
    A toolbar above the grid provides Create/Edit/Delete/Restore buttons for CRUD operations.
    The create/edit form is a modal populated via JavaScript from the selected grid row.
    Asset amounts are displayed with their currency units; soft-deleted assets can be restored.
*@
@using Maroik.Website.Models.ViewModels.AccountBook
@using Maroik.Core.Domain.Finance
@model AccountBookPageViewModel
<section class="content">
    <div class="card card-primary">
        <div class="card-header">
            <h3 class="card-title">@Localizer["AccountBook Asset"].Value</h3>
        </div>

        <div class="card-body">
            <nav class="navbar-expand navbar-dark" style="position: relative; display: block !important; overflow-x: auto; overflow-y:hidden; align-items: center ">
                <ul class="navbar-nav">
                    <li class="nav-item" style="padding-bottom: 10px; padding-right: 7px;">
                        <button type="button" class="btn btn-primary btn-block btn-sm" data-toggle="modal" data-target="#createAssetDialogModal" data-backdrop="static" data-keyboard="false" style="width: 100px !important;"><i class="fa fa-plus" style="padding-right:3px;"></i> @Localizer["CREATE"].Value</button>
                    </li>
                    <li class="nav-item" style="padding-bottom: 10px; padding-right: 7px;">
                        <button id="btnEditAssetGridRow" type="button" class="btn btn-success btn-block btn-sm" data-errorMessageSelectGridRow="@Localizer["Please select grid row"].Value" style="width: 100px !important;"><i class="fas fa-edit" style="padding-right:3px;"></i> @Localizer["EDIT"].Value</button>
                    </li>
                    <li class="nav-item" style="padding-bottom: 10px; padding-right: 7px;">
                        <button id="btnConfirmDeleteAsset" type="button" class="btn btn-danger btn-block btn-sm" data-errorMessageSelectGridRow="@Localizer["Please select grid row"].Value" style="width: 100px !important;"><i class="fa fa-trash" style="padding-right:3px;"></i> @Localizer["DELETE"].Value</button>
                    </li>
                    <li class="nav-item" style="padding-bottom: 10px; padding-right: 7px;">
                        <button id="btnExportExcelAsset" type="button" class="btn btn-secondary btn-block btn-sm" style="width: 100px !important;"><i class="fas fa-file-excel" style="padding-right:3px;"></i> @Localizer["EXCEL"].Value</button>
                    </li>
                    <li class="nav-item ml-auto">
                        <input type="text" id="gridSearch" placeholder="@Localizer["Search..."].Value" style="margin-bottom: 7px; text-align: center; font-size: .7em; padding: 5px 0; color: #000; border: none; " />
                    </li>
                </ul>
            </nav>
            @Html.AjaxGrid(Url.Action("Asset", "AccountBook")!)
        </div>
    </div>
</section>

@*<!--createAssetDialogModal-->*@
<div class="modal fade" tabindex="-1" role="dialog" id="createAssetDialogModal">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div id="createAssetTabs">
                @*<!--Tab Menu-->*@
                <ul>
                    <li><a href="#createAssetTabs-1">@Localizer["Add Asset"].Value</a></li>
                </ul>
                @*Tabs-1: Create Asset Modal*@
                <div id="createAssetTabs-1">
                    <form id="formCreateAsset">
                        <div class="form-row">
                            <div class="form-group col-md-6 mb-3">
                                <label for="createAssetProductName">@Localizer["ProductName"].Value</label>
                                <input class="form-control form-control-sm" type="text" data-val="true" data-val-required="@Localizer["Please enter ProductName"].Value" id="createAssetProductName" name="createAssetProductName" value="">
                                <span class="field-validation-valid text-danger" data-valmsg-for="createAssetProductName" data-valmsg-replace="true"></span>
                            </div>
                            <div class="form-group col-md-6 mb-3">
                                <label for="createAssetItem">@Localizer["Item"].Value</label>
                                <br />
                                <select id="createAssetItem" name="createAssetItem" class="form-control form-control-sm" style="max-width:100%;text-overflow:ellipsis;">
                                    @* Options are rendered from AssetItemType (the domain enum backing Asset.Item /
                                       the DB's Asset_Item_check constraint) rather than hardcoded, so this list can't
                                       drift out of sync with the taxonomy the server actually accepts. *@
                                    @foreach (string item in Enum.GetNames<AssetItemType>())
                                    {
                                        <option value="@item">@Localizer[item].Value</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md-6 mb-3">
                                <label for="createAssetAmount">@Localizer["Amount"].Value</label>
                                <input class="form-control form-control-sm" type="number" id="createAssetAmount" name="createAssetAmount" value="0">
                            </div>
                            <div class="form-group col-md-6 mb-3">
                                <label for="createAssetMonetaryUnit">@Localizer["MonetaryUnit"].Value</label>
                                <input class="form-control form-control-sm" type="text" data-val="true" data-val-required="@Localizer["Please enter MonetaryUnit"].Value" id="createAssetMonetaryUnit" name="createAssetMonetaryUnit" value="">
                                <span class="field-validation-valid text-danger" data-valmsg-for="createAssetMonetaryUnit" data-valmsg-replace="true"></span>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md-6 mb-3">
                                <label for="createAssetNote">@Localizer["Note"].Value</label>
                                <input class="form-control form-control-sm" type="text" data-val="false" id="createAssetNote" name="createAssetNote" value="">
                            </div>
                        </div>
                        <div class="modal-footer justify-content-between">
                            <button type="button" class="btn btn-secondary" data-dismiss="modal">@Localizer["Close"].Value</button>
                            <input type="submit" class="btn btn-primary" value="@Localizer["Save"].Value" />
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@*<!--EditAssetDialogModal-->*@
<div class="modal fade" tabindex="-1" role="dialog" id="editAssetDialogModal">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div id="editAssetTabs">
                @*<!--Tab Menu-->*@
                <ul>
                    <li><a href="#editAssetTabs-1">@Localizer["Edit Asset"].Value</a></li>
                </ul>
                @*Tabs-1: Edit Asset Modal*@
                <div id="editAssetTabs-1">
                    <form id="formEditAsset">
                        <div class="form-row">
                            <div class="form-group col-md-6 mb-3">
                                <label for="editAssetProductName">@Localizer["ProductName"].Value</label>
                                <input class="form-control form-control-sm" type="text" data-val="true" id="editAssetProductName" name="editAssetProductName" value="">
                                <input id="editAssetOriginalProductName" type="hidden" data-val="true" />
                            </div>
                            <div class="form-group col-md-6 mb-3">
                                <label for="editAssetItem">@Localizer["Item"].Value</label>
                                <br />
                                <select id="editAssetItem" name="editAssetItem" class="form-control form-control-sm" style="max-width:100%;text-overflow:ellipsis;">
                                    @foreach (string item in Enum.GetNames<AssetItemType>())
                                    {
                                        <option value="@item">@Localizer[item].Value</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md-6 mb-3">
                                <label for="editAssetAmount">@Localizer["Amount"].Value</label>
                                <input class="form-control form-control-sm" type="number" id="editAssetAmount" name="editAssetAmount" value="0">
                            </div>
                            <div class="form-group col-md-6 mb-3">
                                <label for="editAssetMonetaryUnit">@Localizer["MonetaryUnit"].Value</label>
                                <input class="form-control form-control-sm" type="text" data-val="true" data-val-required="@Localizer["Please enter MonetaryUnit"].Value" id="editAssetMonetaryUnit" name="editAssetMonetaryUnit" value="">
                                <span class="field-validation-valid text-danger" data-valmsg-for="editAssetMonetaryUnit" data-valmsg-replace="true"></span>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md-6 mb-3">
                                <label for="editAssetNote">@Localizer["Note"].Value</label>
                                <input class="form-control form-control-sm" type="text" data-val="false" id="editAssetNote" name="editAssetNote" value="">
                            </div>
                            <div class="form-group col-md-6 mb-3">
                                <label for="editAssetDeleted">@Localizer["Deleted"].Value</label>
                                <input class="form-control form-control-sm" type="checkbox" id="editAssetDeleted" name="editAssetDeleted" />
                            </div>
                        </div>
                        <div class="modal-footer justify-content-between">
                            <button type="button" class="btn btn-secondary" data-dismiss="modal">@Localizer["Close"].Value</button>
                            <input type="submit" class="btn btn-primary" value="@Localizer["Save"].Value" />
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@*<!--ConfirmDeleteDialogModal-->*@
<div class="modal" tabindex="-1" role="dialog" id="confirmDeleteAssetDialogModal">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-body">
                @Localizer["Are you sure to delete?"].Value
            </div>
            <div class="modal-footer">
                <button id="btnDeleteAsset" type="button" class="btn btn-danger" data-errorMessageSelectGridRow="@Localizer["Please select grid row"].Value">@Localizer["DELETE"].Value</button>
                <button type="button" class="btn btn-secondary" data-dismiss="modal">@Localizer["Close"].Value</button>
            </div>
        </div>
    </div>
</div>
@* Page-specific JavaScript: site.js *@
@section Scripts{
    <script src="~/user/custom/AccountBook/Asset/js/site.js" asp-append-version="true"></script>
}