@*
    AccountBook/_ExpenditureGrid.cshtml
    NonFactors MVC Grid partial for the expenditure transaction list.
    Renders a filterable, sortable data table of ExpenditureOutputViewModel records.
    Each row is clickable to populate the edit form in the parent Expenditure.cshtml view.
    Note: this partial should contain only the grid declaration (NonFactors constraint).
*@
@model IQueryable<Maroik.Website.Models.ViewModels.AccountBook.ExpenditureOutputViewModel>
@* Should only include grid declaration *@

@(Html
    .Grid(Model)
    .Build(columns =>
    {
        columns.Add(model => model.Id).Titled(Localizer[nameof(Maroik.Website.Models.ViewModels.AccountBook.ExpenditureOutputViewModel.Id)]).Hidden();
        columns.Add(model => model.MainClass).Titled(Localizer[nameof(Maroik.Website.Models.ViewModels.AccountBook.ExpenditureOutputViewModel.MainClass)]);
        columns.Add(model => model.SubClass).Titled(Localizer[nameof(Maroik.Website.Models.ViewModels.AccountBook.ExpenditureOutputViewModel.SubClass)]);
        columns.Add(model => model.Content).Titled(Localizer[nameof(Maroik.Website.Models.ViewModels.AccountBook.ExpenditureOutputViewModel.Content)]);
        columns.Add(model => model.Amount).Titled(Localizer[nameof(Maroik.Website.Models.ViewModels.AccountBook.ExpenditureOutputViewModel.Amount)]).Formatted(Maroik.Website.Constants.AmountDisplay.GridFormat);
        columns.Add(model => model.MonetaryUnit).Titled(Localizer[nameof(Maroik.Website.Models.ViewModels.AccountBook.ExpenditureOutputViewModel.MonetaryUnit)]);
        columns.Add(model => model.PaymentMethod).Titled(Localizer[nameof(Maroik.Website.Models.ViewModels.AccountBook.ExpenditureOutputViewModel.PaymentMethod)]);
        columns.Add(model => model.Note).Titled(Localizer[nameof(Maroik.Website.Models.ViewModels.AccountBook.ExpenditureOutputViewModel.Note)]);
        columns.Add(model => model.MyDepositAsset).Titled(Localizer[nameof(Maroik.Website.Models.ViewModels.AccountBook.ExpenditureOutputViewModel.MyDepositAsset)]);
        columns.Add(model => model.Created).Titled(Localizer[nameof(Maroik.Website.Models.ViewModels.AccountBook.ExpenditureOutputViewModel.Created)]);
        columns.Add(model => model.Updated).Titled(Localizer[nameof(Maroik.Website.Models.ViewModels.AccountBook.ExpenditureOutputViewModel.Updated)]);
    })
    .Id("expenditureGrid")
    .Css("table table-striped")
    .AppendCss("table-hover")
    //.Attributed(new { data_type = "individuals" })
    .RowAttributed(model => new { @class = "table-inactive clsGridRow", data_id = model.Id})
    .Using(GridFilterMode.Row)
    .Empty(Localizer["No data found"])
    .Filterable()
    .Sortable()
    .Pageable(pager => {
        pager.PageSizes = new Dictionary<int, string> { { 10, "10" }, { 25, "25" }, { 50, "50" }, {100, "100" } };
        pager.ShowPageSizes = true;
        pager.RowsPerPage = 10;
    })
)