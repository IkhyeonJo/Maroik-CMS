@*
    Forum/FreeForum.cshtml
    Main FreeForum (public board) page.
    Uses FreeForumOutputViewModel to drive three display modes controlled by Model.Method:
      - "Index"  : Paginated post list with pinned notices, search bar, and comment count badges.
      - "Detail" : Post detail panel showing full content, attached file, and comment thread.
      - "Edit"   : Summernote-powered post editor for creating or editing a post (with file upload).
    All date/time values are converted to the logged-in user's local time zone for display.
    The Pager model drives the 5-link page navigation at the bottom of the list.
*@
@using Maroik.Website.Models.ViewModels.Forum
@using System.Web

@model FreeForumOutputViewModel

@{
    string selectedSearchType = Model.SelectedSearchType;
    long maxAttachedFileSizeBytes = (long)ViewBag.MaxAttachedFileSizeBytes;
    string typedSearchText = Model.TypedSearchText;
    var loggedInAccount = Model.LoggedInAccount;
    string loggedInAccountTimeZoneIanaId = Model.LoggedInAccountTimeZoneIanaId;
}

@Html.Hidden(nameof(maxAttachedFileSizeBytes), maxAttachedFileSizeBytes)
@Html.Hidden("localizerIETFLanguageTag", Localizer["IETFLanguageTag"].Value)

<section class="content">
    <div class="card card-primary">
        <div class="card-header">
            <h3 class="card-title">@Localizer["Free Forum"].Value</h3>
        </div>
        <div class="card-body">
            @switch (Model.Method)
            {
                case "write":
                    <form id="formWriteBoard">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="form-group">
                            <label for="writeBoardTitle">@Localizer["Title"].Value</label>
                            <input class="form-control" type="text" data-val="true" data-val-required="@Localizer["Title is required"].Value" id="writeBoardTitle" name="writeBoardTitle" value="" required maxlength="100">
                            <span class="field-validation-valid text-danger" data-valmsg-for="writeBoardTitle" data-valmsg-replace="true"></span>
                        </div>
                        <div class="form-group">
                            <label for="writeBoardContent" class="control-label">@Localizer["Content"].Value</label>
                            <textarea name="writeBoardContent" id="writeBoardContent" maxlength="16384"></textarea> @*maxlength: 16KB*@
                        </div>

                        @if (loggedInAccount.Role == Role.Admin)
                        {
                            <div class="form-group">
                                <div class="custom-control custom-checkbox">
                                    <input class="custom-control-input" type="checkbox" id="writeBoardNoticed" />
                                    <label for="writeBoardNoticed" class="custom-control-label">@Localizer["Noticed"].Value</label>
                                </div>
                            </div>
                        }

                        <div class="form-group">
                            <div class="custom-control custom-checkbox">
                                <input class="custom-control-input" type="checkbox" id="writeBoardLocked" />
                                <label for="writeBoardLocked" class="custom-control-label">@Localizer["Locked"].Value</label>
                            </div>
                        </div>

                        <div class="form-group">
                            <input type="file" id="writeUploadedFile" name="writeUploadedFile" accept=".zip" data-errorMessage="@Localizer["File size must be smaller than {0}MB.", maxAttachedFileSizeBytes.ToMegabytesLabel()]">
                            <p class="help-block">@Localizer["Only zip extension allowed."].Value</p>
                        </div>

                        <div class="form-group">
                            <div class="float-right">
                                <button id="btnFreeForumShowWriteBoardLoading" type="submit" class="btn btn-primary">@Localizer["Write"].Value</button>
                            </div>
                            <a asp-controller="Forum" asp-action="FreeForum" class="btn btn-default">@Localizer["List"].Value</a>
                        </div>
                    </form>
                    break;
                case "detail":
                    <div class="mailbox-read-info">
                        <h5>@Localizer["Title"].Value: @Model.BoardOutputViewModel!.Title</h5>
                        <h6>
                            @Localizer["Writer"].Value: @Model.BoardOutputViewModel!.Writer
                        </h6>
                        <span class="mailbox-read-time float-left">@Localizer["Views"].Value: @Model.BoardOutputViewModel!.Views</span>

                        <span class="mailbox-read-time float-right">
                            @Localizer["Updated"].Value: [<span id="free_forum_detail_updated">@Model.BoardOutputViewModel.Updated.ToViewerFormattedString(loggedInAccount.SeesLocalTime(), loggedInAccountTimeZoneIanaId)</span>]
                        </span>
                        <br />
                    </div>

                    <div id="detailBoardContent" class="mailbox-read-message" style="@(Model.BoardOutputViewModel.IsImgTagIncluded ? "display:none;" : "")">
                        @Html.Raw(Model.BoardOutputViewModel.Content)
                    </div>

                    <div class="card-footer bg-dark">
                        @if (!string.IsNullOrEmpty(Model.BoardOutputViewModel.BoardAttachedFileName))
                        {

                            <ul class="mailbox-attachments d-flex align-items-stretch clearfix">
                                <li>
                                    <span class="mailbox-attachment-icon"><i class="far fa-file"></i></span>

                                    <div class="mailbox-attachment-info">
                                        <a id="aDetailBoardAttachedFile" href="#" class="mailbox-attachment-name" data-boardid="@Model.DetailBoardId" data-name="@($"{Model.BoardOutputViewModel.BoardAttachedFileName}{Model.BoardOutputViewModel.BoardAttachedFileExtension}")"><i class="fas fa-paperclip"></i>@Model.BoardOutputViewModel.BoardAttachedFileName@Model.BoardOutputViewModel.BoardAttachedFileExtension</a>
                                        <span class="mailbox-attachment-size clearfix mt-1">
                                            <span>
                                                @(Model.BoardOutputViewModel.BoardAttachedFileSize.ToKilobytesLabel())KB
                                            </span>
                                        </span>
                                    </div>
                                </li>
                            </ul>
                        }
                    </div>
                    <div class="card-footer bg-dark">
                        <div class="float-right">
                            @if (Model.BoardOutputViewModel.CanModify)
                            {
                                <button id="btnFreeForumModify" type="button" class="btn btn-primary" data-link="@Url.Action("FreeForum", "Forum", new { method = "edit", boardId = (long)Model.DetailBoardId, page = Model.DetailCurrentPage })">@Localizer["Modify"].Value</button>
                            }
                            @if (Model.BoardOutputViewModel.CanDelete)
                            {
                                <button id="btnFreeForumConfirmDeleteBoard" type="button" class="btn btn-danger">@Localizer["Delete"].Value</button>
                            }
                        </div>
                        <button id="btnFreeForumList" type="button" class="btn btn-default" data-link="@Url.Action("FreeForum", "Forum", new { page = Model.DetailCurrentPage })">@Localizer["List"].Value</button>
                    </div>

                    <div class="card-footer card-comments">
                        @foreach (var comment in Model.DetailBoardComments)
                        {
                            bool isCommentWriterAdmin = comment.Writer.IsAdmin(Model.AdminNicknames);
                            if (Model.BoardOutputViewModel.Writer == comment.Writer) /*Change background color if the commenter is the post author*/
                            {
                                <div class="card-comment" style="background-color:#003366;">
                                    <img class="img-circle img-sm" src="@comment.AvatarImagePath" alt="">

                                    <div class="comment-text">
                                        <span class="username">
                                            @if (isCommentWriterAdmin)
                                            {
                                                <span style="font-weight:bold; color:green;">@comment.Writer</span>
                                            }
                                            else
                                            {
                                                <span>@comment.Writer</span>
                                            }
                                            <span class="text-muted float-middle">
                                                @Localizer["Created"].Value: [<span class="free_forum_detail_comment_created">@comment.Created.ToViewerFormattedString(loggedInAccount.SeesLocalTime(), loggedInAccountTimeZoneIanaId)</span>]
                                            </span>
                                            @{
                                                if (loggedInAccount.IsOwnerOrAdmin(comment.Writer))/*If the visitor is the author or admin*/
                                                {
                                                    <span class="text-muted float-right" style="margin: 0 0 0 3px"><a class="hover aFreeForumDeleteComment" href="#" data-commentId="@comment.Id" data-detailBoardId="@Model.DetailBoardId" data-detailCurrentPage="@Model.DetailCurrentPage">@Localizer["Delete"].Value</a></span>
                                                }
                                            }
                                        </span>
                                        @HttpUtility.HtmlDecode(comment.Content)
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="card-comment">
                                    <img class="img-circle img-sm" src="@comment.AvatarImagePath" alt="">

                                    <div class="comment-text">
                                        <span class="username">
                                            @if (isCommentWriterAdmin)
                                            {
                                                <span style="font-weight:bold; color:green;">@comment.Writer</span>
                                            }
                                            else
                                            {
                                                <span>@comment.Writer</span>
                                            }
                                            <span class="text-muted float-middle">
                                                @Localizer["Created"].Value: [<span class="free_forum_detail_comment_created">@comment.Created.ToViewerFormattedString(loggedInAccount.SeesLocalTime(), loggedInAccountTimeZoneIanaId)</span>]
                                            </span>
                                            @{
                                                if (loggedInAccount.IsOwnerOrAdmin(comment.Writer))/*If the visitor is the author or admin*/
                                                {
                                                    <span class="text-muted float-right" style="margin: 0 0 0 3px"><a class="hover aFreeForumDeleteComment" href="#" data-commentId="@comment.Id" data-detailBoardId="@Model.DetailBoardId" data-detailCurrentPage="@Model.DetailCurrentPage">@Localizer["Delete"].Value</a></span>
                                                }
                                            }
                                        </span>
                                        @HttpUtility.HtmlDecode(comment.Content)
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    <div class="card-footer">
                        @if (loggedInAccount.Role == Role.Anonymous)
                        {
                            <form id="formWriteFreeComment">
                                @* ReSharper disable Html.PathError *@
                                <img alt="" class="img-fluid img-circle img-sm" src="~/upload/Management/Profile/default-avatar.jpg">
                                @* ReSharper restore Html.PathError *@
                                <div class="img-push">
                                    <input id="writeFreeCommentContent" type="text" class="form-control form-control-sm" placeholder="@Localizer["Only logged in users can write comments."].Value">
                                </div>
                            </form>
                        }
                        else
                        {
                            <form id="formWriteFreeComment" data-detailBoardId="@(Model.DetailBoardId)" data-detailCurrentPage="@(Model.DetailCurrentPage)" data-errorMessage="@Localizer["Please write the content."].Value">
                                <img alt="" class="img-fluid img-circle img-sm" src="@loggedInAccount.AvatarImagePath">
                                <div class="img-push">
                                    <input id="writeFreeCommentContent" type="text" class="form-control form-control-sm" placeholder="@Localizer["Press enter to post comment."].Value">
                                </div>
                            </form>
                        }
                    </div>
                    break;
                case "edit":
                    <form id="formEditBoard" data-editBoardId="@(Model.EditBoardId)" data-editCurrentPage="@(Model.EditCurrentPage)">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="form-group">
                            <label for="editBoardTitle">@Localizer["Title"].Value</label>
                            <input class="form-control" type="text" data-val="true" data-val-required="@Localizer["Title is required"].Value" id="editBoardTitle" name="editBoardTitle" value="@Model.BoardOutputViewModel!.Title" required maxlength="100">
                            <span class="field-validation-valid text-danger" data-valmsg-for="editBoardTitle" data-valmsg-replace="true"></span>
                        </div>
                        <div id="divEditBoardContent" class="form-group" style="@(Model.BoardOutputViewModel!.IsImgTagIncluded ? "display:none;" : "")">
                            <label for="editBoardContent" class="control-label"></label>
                            <textarea name="editBoardContent" id="editBoardContent" maxlength="16384">@Html.Raw(Model.BoardOutputViewModel!.Content)</textarea> @*maxlength: 16KB*@
                        </div>

                        <div class="form-group">
                            <div class="custom-control custom-checkbox">
                                @if (Model.BoardOutputViewModel.Locked)
                                {
                                    <input class="custom-control-input" type="checkbox" id="editBoardLocked" checked />
                                }
                                else
                                {
                                    <input class="custom-control-input" type="checkbox" id="editBoardLocked" />
                                }
                                <label for="editBoardLocked" class="custom-control-label">@Localizer["Locked"].Value</label>
                            </div>
                        </div>

                        <div class="card-footer bg-dark">
                            @if (!string.IsNullOrEmpty(Model.BoardOutputViewModel.BoardAttachedFileName))
                            {
                                <ul class="mailbox-attachments d-flex align-items-stretch clearfix">
                                    <li>
                                        <span class="mailbox-attachment-icon"><i class="far fa-file"></i></span>

                                        <div class="mailbox-attachment-info">
                                            <a id="aEditBoardAttachedFile" href="#" class="mailbox-attachment-name" data-boardid="@Model.EditBoardId" data-name="@($"{Model.BoardOutputViewModel.BoardAttachedFileName}{Model.BoardOutputViewModel.BoardAttachedFileExtension}")"><i class="fas fa-paperclip"></i>@Model.BoardOutputViewModel.BoardAttachedFileName@Model.BoardOutputViewModel.BoardAttachedFileExtension</a>
                                            <span class="mailbox-attachment-size clearfix mt-1">
                                                <span>
                                                    @(Model.BoardOutputViewModel.BoardAttachedFileSize.ToKilobytesLabel())KB
                                                </span>
                                            </span>
                                        </div>
                                    </li>
                                </ul>
                            }
                        </div>

                        <div class="form-group">
                            <input type="file" id="editUploadedFile" name="editUploadedFile" accept=".zip" data-errorMessage="@Localizer["File size must be smaller than {0}MB.", maxAttachedFileSizeBytes.ToMegabytesLabel()]">
                            <p class="help-block">@Localizer["Only zip extension allowed."].Value</p>
                        </div>

                        <div class="form-group">
                            <div class="float-right">
                                <button id="btnFreeForumSubmitModify" type="submit" class="btn btn-primary">@Localizer["Modify"].Value</button>
                            </div>
                            <a asp-controller="Forum" asp-action="FreeForum" class="btn btn-default">@Localizer["List"].Value</a>
                        </div>
                    </form>
                    break;
                default:
                    <nav class="navbar-expand navbar-dark" style="position: relative; display: block !important; overflow-x: auto; overflow-y:hidden; align-items: center ">
                        <ul class="navbar-nav">
                            <li class="nav-item" style="padding-bottom: 10px; padding-right: 7px;">
                                <button id="btnFreeForumWrite" type="button" class="btn btn-success btn-block btn-sm" style="width: 100px !important;"><i class="fas fa-edit" style="padding-right:3px;"></i> @Localizer["Write"].Value</button>
                            </li>
                            <li class="nav-item ml-auto">
                                <div class="input-group input-group-sm">
                                    <select id="searchType" name="searchType" style="margin: 0 3px 0 0;">
                                        @switch (selectedSearchType)
                                        {
                                            case "Title":
                                                <option value="Title" selected>@Localizer["Title"].Value</option>
                                                <option value="Writer">@Localizer["Writer"]</option>
                                                break;
                                            case "Writer":
                                                <option value="Title">@Localizer["Title"].Value</option>
                                                <option value="Writer" selected>@Localizer["Writer"]</option>
                                                break;
                                            default:
                                                <option value="Title">@Localizer["Title"].Value</option>
                                                <option value="Writer">@Localizer["Writer"]</option>
                                                break;
                                        }
                                    </select>
                                    <input class="form-control" type="text" id="btnFreeForumSearchText" value="@typedSearchText">
                                    <div class="input-group-append">
                                        <button id="btnFreeForumSearchBoard" class="btn btn-primary">
                                            <i class="fas fa-search"></i>
                                        </button>
                                    </div>
                                </div>
                            </li>
                        </ul>
                    </nav>
                    <div style="overflow:auto;">
                        <table id="tblFreeForum" class="table table-striped table-bordered table-hover">
                            <thead>
                                <tr>
                                    <th>@Localizer["Type"].Value</th>
                                    <th>@Localizer["Title"].Value</th>
                                    <th>@Localizer["Writer"].Value</th>
                                    <th>@Localizer["Created"].Value</th>
                                    <th>@Localizer["Views"].Value</th>
                                    <th>@Localizer["Attachment"].Value</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var noticeBoard in Model.NoticeBoards)
                                {
                                    int commentsOfUndeletedSelectedBoardCount = Model.CommentCountByBoardId.GetValueOrDefault(noticeBoard.Id, 0);
                                    var boardAttachedFilesWithName = Model.AttachedFilesByBoardId.GetValueOrDefault(noticeBoard.Id, []);
                                    bool noticeBoardTitleVisible = noticeBoard.IsTitleVisibleToOwnerOrAdmin(loggedInAccount);

                                    <tr style="background-color: lightgray;">
                                        <td style="color:green;font-weight:bold;">@Localizer["Notice"]</td>
                                        <td>
                                            @if (noticeBoard.Locked)
                                            {
                                                <i class="fa @(noticeBoardTitleVisible ? "fa-lock-open" : "fa-lock")" aria-hidden="true"></i>
                                            }
                                            @if (noticeBoardTitleVisible)
                                            {
                                                <text>@Html!.ActionLink($"{noticeBoard.Title} [{commentsOfUndeletedSelectedBoardCount}]", "FreeForum", new {method = "detail", boardId = noticeBoard.Id, page = Model.Pager!.CurrentPage}, new { style = "color: green; font-weight: bold;" })</text>
                                            }
                                            else
                                            {
                                                <span style="font-weight:bold; color:green;"> @Localizer["Only a writer and admin can see it."].Value</span>
                                            }
                                        </td>

                                        <td><span style="font-weight:bold; color:green;">@noticeBoard.Writer</span></td>

                                        <td class="free_forum_board_created"><span style="font-weight:bold; color:green;">@noticeBoard.Created.ToViewerFormattedString(loggedInAccount.SeesLocalTime(), loggedInAccountTimeZoneIanaId)</span></td>

                                        <td><span style="font-weight:bold; color:green;">@noticeBoard.View</span></td>
                                        @if (boardAttachedFilesWithName.Count != 0)
                                        {
                                            <td><span style="font-weight:bold; color:green;"><i class="fas fa-paperclip"></i></span></td>
                                        }
                                        else
                                        {
                                            <td></td>
                                        }
                                    </tr>
                                }
                                @foreach (var board in Model.Boards)
                                {
                                    int commentsOfUndeletedSelectedBoardCount = Model.CommentCountByBoardId.GetValueOrDefault(board.Id, 0);
                                    var attachedFilesWithName = Model.AttachedFilesByBoardId.GetValueOrDefault(board.Id, []);
                                    bool boardTitleVisible = board.IsTitleVisibleToOwnerOrAdmin(loggedInAccount);
                                    bool isBoardWriterAdmin = board.Writer.IsAdmin(Model.AdminNicknames);

                                    <tr>
                                        <td>@Localizer["Free Forum"]</td>
                                        <td>
                                            @if (board.Locked)
                                            {
                                                <i class="fa @(boardTitleVisible ? "fa-lock-open" : "fa-lock")" aria-hidden="true"></i>
                                            }
                                            @if (boardTitleVisible)
                                            {
                                                <text>@Html!.ActionLink($"{board.Title} [{commentsOfUndeletedSelectedBoardCount}]", "FreeForum", new {method = "detail", boardId = board.Id, page = Model.Pager!.CurrentPage})</text>
                                            }
                                            else
                                            {
                                                <text>@Localizer["Only a writer and admin can see it."].Value</text>
                                            }
                                        </td>

                                        @if (isBoardWriterAdmin)
                                        {
                                            <td><span style="font-weight:bold; color:green;">@board.Writer</span></td>
                                        }
                                        else
                                        {
                                            <td><span>@board.Writer</span></td>
                                        }

                                        <td class="free_forum_board_created">@board.Created.ToViewerFormattedString(loggedInAccount.SeesLocalTime(), loggedInAccountTimeZoneIanaId)</td>

                                        <td>@board.View</td>
                                        @if (attachedFilesWithName.Count != 0)
                                        {
                                            <td><i class="fas fa-paperclip"></i></td>
                                        }
                                        else
                                        {
                                            <td></td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <hr />

                    <nav aria-label="Page navigation example">
                        @if (Model.Pager!.TotalPages > 0)
                        {
                            <ul class="pagination justify-content-center">

                                @if (Model.Pager!.CurrentPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" asp-controller="Forum" asp-action="FreeForum" asp-route-page="1" asp-route-searchType="@selectedSearchType" asp-route-searchText="@typedSearchText">&lt;&lt;</a>
                                    </li>
                                    <li class="page-item">
                                        <a class="page-link" asp-controller="Forum" asp-action="FreeForum" asp-route-page="@(Model.Pager!.CurrentPage-1)" asp-route-searchType="@selectedSearchType" asp-route-searchText="@typedSearchText">&lt;</a>
                                    </li>
                                }

                                @for (int pageNumber = Model.Pager.StartPage; pageNumber <= Model.Pager.EndPage; pageNumber++)
                                {
                                    <li class="page-item @(pageNumber == Model.Pager!.CurrentPage ? "active" : "")">

                                        @{
                                            int number = pageNumber;
                                        }
                                        <a class="page-link" asp-controller="Forum" asp-action="FreeForum" asp-route-page="@number" asp-route-searchType="@selectedSearchType" asp-route-searchText="@typedSearchText">@number</a>
                                    </li>
                                }

                                @if (Model.Pager!.CurrentPage < Model.Pager.TotalPages)
                                {
                                    <li class="page-item">
                                        <a class="page-link" asp-controller="Forum" asp-action="FreeForum" asp-route-page="@(Model.Pager!.CurrentPage + 1)" asp-route-searchType="@selectedSearchType" asp-route-searchText="@typedSearchText">&gt;</a>
                                    </li>
                                    <li class="page-item">
                                        <a class="page-link" asp-controller="Forum" asp-action="FreeForum" asp-route-page="@(Model.Pager.TotalPages)" asp-route-searchType="@selectedSearchType" asp-route-searchText="@typedSearchText">&gt;&gt;</a>
                                    </li>
                                }
                            </ul>
                        }
                    </nav>
                    break;
            }
        </div>
    </div>
</section>

<div class="modal" id="loading">
    @* ReSharper disable Html.PathError *@
    <img alt="" src="~/upload/Forum/FreeForum/ajax-loader.gif" />
    @* ReSharper restore Html.PathError *@
</div>

@*<!--ConfirmDeleteDialogModal-->*@
<div class="modal" tabindex="-1" role="dialog" id="confirmDeleteBoardDialogModal">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-body">
                @Localizer["Are you sure to delete?"].Value
            </div>
            <div class="modal-footer">
                <button id="btnFreeForumDeleteBoard" type="button" class="btn btn-danger" data-boardId="@Model.DetailBoardId">@Localizer["Delete"].Value</button>
                <button type="button" class="btn btn-secondary" data-dismiss="modal">@Localizer["Close"].Value</button>
            </div>
        </div>
    </div>
</div>
@* Page-specific JavaScript: site.js, site.js, site.js *@
@section Scripts{
    @switch (loggedInAccount.Role)
    {
        case Role.Admin:
            <script src="~/admin/custom/Forum/FreeForum/js/site.js" asp-append-version="true"></script>
            break;
        case Role.User:
            <script src="~/user/custom/Forum/FreeForum/js/site.js" asp-append-version="true"></script>
            break;
        case Role.Anonymous:
            <script src="~/anonymous/custom/Forum/FreeForum/js/site.js" asp-append-version="true"></script>
            break;
    }
}
