@*
    Notice/_FixedIncomeGrid.cshtml
    NonFactors MVC Grid partial for the fixed income list.
    Renders a filterable, sortable data table of FixedIncomeOutputViewModel records.
    Noticed and Expired columns are highlighted to draw attention to upcoming or overdue entries.
    Each row is clickable to populate the edit form in the parent FixedIncome.cshtml view.
    Note: this partial should contain only the grid declaration (NonFactors constraint).
*@
@model IQueryable<Maroik.Website.Models.ViewModels.Notice.FixedIncomeOutputViewModel>
@* Should only include grid declaration *@

@(Html
    .Grid(Model)
    .Build(columns =>
    {
        columns.Add(model => model.Id).Titled(Localizer[nameof(Maroik.Website.Models.ViewModels.Notice.FixedIncomeOutputViewModel.Id)]).Hidden();
        columns.Add(model => model.MainClass).Titled(Localizer[nameof(Maroik.Website.Models.ViewModels.Notice.FixedIncomeOutputViewModel.MainClass)]);
        columns.Add(model => model.SubClass).Titled(Localizer[nameof(Maroik.Website.Models.ViewModels.Notice.FixedIncomeOutputViewModel.SubClass)]);
        columns.Add(model => model.Content).Titled(Localizer[nameof(Maroik.Website.Models.ViewModels.Notice.FixedIncomeOutputViewModel.Content)]);
        columns.Add(model => model.Amount).Titled(Localizer[nameof(Maroik.Website.Models.ViewModels.Notice.FixedIncomeOutputViewModel.Amount)]).Formatted(Maroik.Website.Constants.AmountDisplay.GridFormat);
        columns.Add(model => model.MonetaryUnit).Titled(Localizer[nameof(Maroik.Website.Models.ViewModels.Notice.FixedIncomeOutputViewModel.MonetaryUnit)]);
        columns.Add(model => model.DepositMonth).Titled(Localizer[nameof(Maroik.Website.Models.ViewModels.Notice.FixedIncomeOutputViewModel.DepositMonth)]);
        columns.Add(model => model.DepositDay).Titled(Localizer[nameof(Maroik.Website.Models.ViewModels.Notice.FixedIncomeOutputViewModel.DepositDay)]);
        columns.Add(model => model.MaturityDate).Titled(Localizer[nameof(Maroik.Website.Models.ViewModels.Notice.FixedIncomeOutputViewModel.MaturityDate)]);
        columns.Add(model => model.Note).Titled(Localizer[nameof(Maroik.Website.Models.ViewModels.Notice.FixedIncomeOutputViewModel.Note)]);
        columns.Add(model => model.DepositMyAssetProductName).Titled(Localizer[nameof(Maroik.Website.Models.ViewModels.Notice.FixedIncomeOutputViewModel.DepositMyAssetProductName)]);
        columns.Add(model => model.Created).Titled(Localizer[nameof(Maroik.Website.Models.ViewModels.Notice.FixedIncomeOutputViewModel.Created)]);
        columns.Add(model => model.Updated).Titled(Localizer[nameof(Maroik.Website.Models.ViewModels.Notice.FixedIncomeOutputViewModel.Updated)]);
    })
    .Id("fixedIncomeGrid")
    .Css("table table-striped")
    .AppendCss("table-hover")
    //.Attributed(new { data_type = "individuals" })
    .RowAttributed(model => new { @class = model.RowCssClass, data_id = model.Id})
    .Using(GridFilterMode.Row)
    .Empty(Localizer["No data found"])
    .Filterable()
    .Sortable()
    .Pageable(pager => {
        pager.PageSizes = new Dictionary<int, string> { { 10, "10" }, { 25, "25" }, { 50, "50" }, {100, "100" } };
        pager.ShowPageSizes = true;
        pager.RowsPerPage = 10;
    })
)