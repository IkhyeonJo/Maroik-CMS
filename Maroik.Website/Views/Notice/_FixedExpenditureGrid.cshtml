@*
    Notice/_FixedExpenditureGrid.cshtml
    NonFactors MVC Grid partial for the fixed expenditure list.
    Renders a filterable, sortable data table of FixedExpenditureOutputViewModel records.
    Noticed and Expired columns are highlighted to draw attention to upcoming or overdue entries.
    Each row is clickable to populate the edit form in the parent FixedExpenditure.cshtml view.
    Note: this partial should contain only the grid declaration (NonFactors constraint).
*@
@model IQueryable<Maroik.Website.Models.ViewModels.Notices.FixedExpenditureOutputViewModel>
@* Should only include grid declaration *@

@(Html
    .Grid(Model)
    .Build(columns =>
    {
        columns.Add(model => model.Id).Titled(Localizer[nameof(Maroik.Website.Models.ViewModels.Notices.FixedExpenditureOutputViewModel.Id)]).Hidden();
        columns.Add(model => model.MainClass).Titled(Localizer[nameof(Maroik.Website.Models.ViewModels.Notices.FixedExpenditureOutputViewModel.MainClass)]);
        columns.Add(model => model.SubClass).Titled(Localizer[nameof(Maroik.Website.Models.ViewModels.Notices.FixedExpenditureOutputViewModel.SubClass)]);
        columns.Add(model => model.Content).Titled(Localizer[nameof(Maroik.Website.Models.ViewModels.Notices.FixedExpenditureOutputViewModel.Content)]);
        columns.Add(model => model.MonetaryUnit).Titled(Localizer[nameof(Maroik.Website.Models.ViewModels.Notices.FixedExpenditureOutputViewModel.MonetaryUnit)]);
        columns.Add(model => model.Amount).Titled(Localizer[nameof(Maroik.Website.Models.ViewModels.Notices.FixedExpenditureOutputViewModel.Amount)]).Formatted(Maroik.Website.Constants.AmountDisplay.GridFormat);
        columns.Add(model => model.PaymentMethod).Titled(Localizer[nameof(Maroik.Website.Models.ViewModels.Notices.FixedExpenditureOutputViewModel.PaymentMethod)]);
        columns.Add(model => model.MyDepositAsset).Titled(Localizer[nameof(Maroik.Website.Models.ViewModels.Notices.FixedExpenditureOutputViewModel.MyDepositAsset)]);
        columns.Add(model => model.DepositMonth).Titled(Localizer[nameof(Maroik.Website.Models.ViewModels.Notices.FixedExpenditureOutputViewModel.DepositMonth)]);
        columns.Add(model => model.DepositDay).Titled(Localizer[nameof(Maroik.Website.Models.ViewModels.Notices.FixedExpenditureOutputViewModel.DepositDay)]);
        columns.Add(model => model.MaturityDate).Titled(Localizer[nameof(Maroik.Website.Models.ViewModels.Notices.FixedExpenditureOutputViewModel.MaturityDate)]);
        columns.Add(model => model.Created).Titled(Localizer[nameof(Maroik.Website.Models.ViewModels.Notices.FixedExpenditureOutputViewModel.Created)]);
        columns.Add(model => model.Updated).Titled(Localizer[nameof(Maroik.Website.Models.ViewModels.Notices.FixedExpenditureOutputViewModel.Updated)]);
        columns.Add(model => model.Note).Titled(Localizer[nameof(Maroik.Website.Models.ViewModels.Notices.FixedExpenditureOutputViewModel.Note)]);
    })
    .Id("fixedExpenditureGrid")
    .Css("table table-striped")
    .AppendCss("table-hover")
    //.Attributed(new { data_type = "individuals" })
    .RowAttributed(model => new { @class = model.RowCssClass, data_id = model.Id})
    .Using(GridFilterMode.Row)
    .Empty(Localizer["No data found"])
    .Filterable()
    .Sortable()
    .Pageable(pager => {
        pager.PageSizes = new Dictionary<int, string> { { 10, "10" }, { 25, "25" }, { 50, "50" }, {100, "100" } };
        pager.ShowPageSizes = true;
        pager.RowsPerPage = 10;
    })
)