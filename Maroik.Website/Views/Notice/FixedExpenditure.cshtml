@*
    Notice/FixedExpenditure.cshtml
    Fixed (recurring) expenditure management page.
    Displays a NonFactors MVC Grid of all fixed expenditure entries (partial view _FixedExpenditureGrid).
    A toolbar provides Create/Edit/Delete buttons for CRUD operations.
    The create/edit form uses a date-picker (Tempusdominus) for the MaturityDate field.
    The asset dropdown is populated from ViewBag.Assets so the user can select which
    account will be debited for the recurring payment.
    Noticed/Expired flags are computed server-side and shown as coloured badges in the grid.
    localization strings for the calendar widget are injected as hidden form fields.
*@
@using Maroik.Core.Domain.Finance
@{
    var assets = ViewBag.Assets as List<AssetResponse> ?? [];
    string? defaultAssetProductName = ViewBag.DefaultAssetProductName as string;
}

