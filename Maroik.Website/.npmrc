
# Fail `npm install` / `npm ci` when the running Node is outside the `engines`
# range in package.json (Node 22 LTS, per Maroik.Website/Dockerfile). Without this
# a version mismatch is only a warning and surfaces later as a confusing runtime
# error in tsc / vitest / jsdom.
engine-strict=true

# No "new major version of npm available" notice: npm is the one bundled with the
# pinned Node 22 (node:22-alpine in the Dockerfile) and is not upgraded separately.
update-notifier=false
